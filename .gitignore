# macOS resource forks — never commit
._*
.DS_Store
todos/
.cursor/
.context/
rust_out

# trace export artifacts must never land in the repo tree
trace-*.html
__pycache__/
*.py[cod]

# Probe scratch-fixture build output (regenerated by build-scratch.ps1)
probes/windows/scratch/bin/
probes/windows/scratch/lifecycle-helpers/bin/
probes/windows/scratch/lifecycle-surface/target/
probes/windows/scratch/shell-execute-ex/target/
probes/windows/scratch/capture-clipboard-surface/target/
probes/windows/22-capture-clipboard/bin/
probes/windows/scratch/lifecycle-surface/Cargo.lock
probes/windows/scratch/shell-execute-ex/Cargo.lock
probes/windows/scratch/capture-clipboard-surface/Cargo.lock

# Normalized capture twins are regenerated by common.ps1 on every probe run and
# are byte-reproducible from the capture beside them; committing both doubles the
# evidence diff for no added information.
probes/*/captures/**/*.normalized

# Sub-phase 2.3 dogfood census output. Regenerate with
# probes/windows/scratch/run-dogfood.ps1 -- the durable record is the report
# under docs/dogfood-reports/, not the raw JSON.
docs/plans/2026-07-31-001-captures/
