# Windows E2E fixture build artifact (compiled by tests/fixture-app-windows/build.ps1 on demand)
/tests/fixture-app-windows/build/

# Cargo
!Cargo.lock

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

