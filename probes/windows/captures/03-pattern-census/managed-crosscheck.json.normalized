                 "target=wpf ct=CheckBox n=1 withpat=1 pats=SynchronizedInput:1,Toggle:1",
                 "target=wpf ct=ComboBox n=1 withpat=1 pats=ExpandCollapse:1,ItemContainer:1,Selection:1,SynchronizedInput:1",
